# Copy to the project root as `.env` (docker compose reads it via env_file)
# or to /etc/rmm-server.env for the systemd unit. Never commit the filled-in
# version — every value below is a secret or environment-specific.

# --- Required ---
# Signs session cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-openssl-rand-hex-32

# Enables secure (HTTPS-only) cookies and the production config path.
NODE_ENV=production

# --- Server ---
PORT=8787
# Where the SQLite file lives. The Docker image defaults this to /app/data/rmm.db.
# DB_PATH=/app/data/rmm.db

# --- Seeding (only read by `npm run seed`) ---
SEED_ADMIN_USER=admin
SEED_ADMIN_EMAIL=admin@yourdomain.com
# `npm run seed` refuses to run without this — there is no default password.
SEED_ADMIN_PASS=

# --- Login hardening ---
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=10

# --- Remote script execution ---
SCRIPT_TIMEOUT_MS=30000

# --- Optional: email alerts (webhooks work without any of this) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# ALERT_EMAIL_TO=ops@yourdomain.com
# ALERT_EMAIL_FROM=rmm@yourdomain.com
